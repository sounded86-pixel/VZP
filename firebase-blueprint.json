{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile including administrative privileges and community rating statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the user" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "village": { "type": "string" },
        "skills": { "type": "array" },
        "thanksCount": { "type": "integer" },
        "createdCount": { "type": "integer" },
        "resolvedCount": { "type": "integer" },
        "blocked": { "type": "boolean" },
        "reportsCount": { "type": "integer" },
        "role": { "type": "string", "enum": ["main_admin", "village_admin", "user"] },
        "adminVillage": { "type": "string" },
        "age": { "type": "integer" },
        "whoInstalled": { "type": "string" },
        "primaryGoal": { "type": "string" },
        "isSimplifiedMode": { "type": "boolean" },
        "referrals": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "referredBy": { "type": "string" },
            "total": { "type": "integer" },
            "totalEarnedPoints": { "type": "integer" },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "userId": { "type": "string" },
                  "userName": { "type": "string" },
                  "userRole": { "type": "string" },
                  "pointsEarned": { "type": "integer" },
                  "date": { "type": "string" },
                  "upgrades": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "tariff": { "type": "string" },
                        "pointsEarned": { "type": "integer" },
                        "date": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "digitalLiteracy": {
          "type": "object",
          "properties": {
            "completed_lessons": { "type": "array", "items": { "type": "integer" } },
            "total_reward": { "type": "integer" },
            "started_at": { "type": "string", "format": "date-time" },
            "completed_at": { "type": "string", "format": "date-time" }
          }
        }
      },
      "required": ["id", "name", "phone", "village", "skills", "thanksCount", "createdCount", "resolvedCount", "blocked", "reportsCount"]
    },
